<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\cdeAppCore\cdeAppCore.csproj" />
    <ProjectReference Include="..\cdeLib\cdeLib.csproj" />
  </ItemGroup>

  <!-- Size formatting cases shared with the cde-tauri Vitest suite (format.test.ts). -->
  <ItemGroup>
    <None Include="..\testdata\size-format-cases.json" Link="testdata\size-format-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
