{
  "AppConfig": {
    "Display": {
      "ProgressUpdateInterval": 5000,
      "ConsoleLogToSeq": true
    },
    "Hashing": {
      "FirstPassSizeInBytes": 65536,
      "DegreesOfParallelism": 2
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": "Warning",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  }
}