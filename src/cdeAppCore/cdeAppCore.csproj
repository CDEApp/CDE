<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Frontend-agnostic application core for CDE GUIs/clients.
    MUST NOT reference WinForms, ASP.NET, or any frontend project. Depends only on cdeLib.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\cdeLib\cdeLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="MinVer" Version="7.0.0" />
  </ItemGroup>

</Project>
